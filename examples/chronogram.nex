#NEXUS
[Chronogram: synthetic time durations with an absolute root age anchor.
 For demonstration only, NOT a biological inference.
 Missing node prob values are filled with random synthetic values in [0.71, 1],
 for display testing only, NOT analysis results; existing values are preserved.
 Root age: 100 Ma; branch lengths are elapsed time in millions of years.
 Shared synthetic taxa: OTU01 through OTU15; shared strictly binary topology.
 Expected tip ages in OTU order:
 20, 0, 35, 0, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60 Ma.]
BEGIN TREES;
  TRANSLATE
    1 OTU01, 2 OTU02, 3 OTU03, 4 OTU04, 5 OTU05,
    6 OTU06, 7 OTU07, 8 OTU08, 9 OTU09, 10 OTU10,
    11 OTU11, 12 OTU12, 13 OTU13, 14 OTU14, 15 OTU15;
  TREE time_branch_example = [&R]
    ((1[&age_95%HPD={18,22},prob=0.98]:30,
      2[&prob=0.738]:50)
      [&age_95%HPD={42,58},prob=0.96]:50,
     (((3[&prob=0.989]:5,4[&prob=0.841]:40)[&prob=0.955]:10,(5[&prob=0.994]:15,6[&prob=0.889]:10)[&prob=0.795]:25)[&prob=0.820]:16,
      (((7[&prob=0.979]:10,8[&prob=0.906]:5)[&prob=0.999]:10,(9[&prob=0.802]:10,10[&prob=0.803]:5)[&prob=0.800]:0)[&prob=0.851]:25,
       ((11[&prob=0.982]:10,12[&prob=0.909]:5)[&prob=0.869]:14,(13[&prob=0.754]:12,(14[&prob=0.867]:5,15[&prob=0.790]:0)[&prob=0.925]:2)[&prob=0.788]:2)[&prob=0.880]:1)[&prob=0.738]:1)
      [&age_95%CredInt={60,72},prob=0.92]:34)
      [&age_mean=100,age_95%HPD={90,110},branch_length_unit=Ma,prob=0.969];
END;
